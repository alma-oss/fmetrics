<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netcoreapp2.2</TargetFramework>
    <OutputType>Library</OutputType>
    <PackageId>Lmc.Metrics</PackageId>
    <Version>1.0.0</Version>
    <RepositoryUrl>https://stash.int.lmc.cz/projects/ARCHI/repos/fmetrics/browse</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="WebServer.fs" />
    <Compile Include="Prometheus.fs" />
    <Compile Include="State.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lmc.ErrorHandling" Version="1.0.0" />
    <PackageReference Include="Suave" Version="2.5.3" />
  </ItemGroup>

</Project>
