<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <PackageId>Alma.Metrics</PackageId>
    <Version>12.0.0</Version>
    <Authors>Almacareer</Authors>
    <Description>Library for showing app metrics for prometheus.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/alma-oss/fmetrics.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/alma-oss/fmetrics</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="src/Audience.fs" />
    <Compile Include="src/Prometheus.fs" />
    <Compile Include="src/State.fs" />
    <Compile Include="src/ResourceAvailability.fs" />
    <Compile Include="src/ServiceStatus.fs" />
  </ItemGroup>

  <Import Project=".paket\Paket.Restore.targets" />
</Project>
